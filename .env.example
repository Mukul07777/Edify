# Edify keys - paste after "=", save, restart run.bat

# AI (free): https://console.groq.com/keys
GROQ_API_KEY=

# Backup AI (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Prune AI gateway (withprune.com), optional: cache, cost tracking, spend caps and blocked risky prompts for every
# AI call. Make a key under Connect > API Keys, and save your Groq/Gemini keys under Connect > Providers.
PRUNE_API_KEY=
# PRUNE_MODEL=openai/gpt-oss-20b   # models to ask Prune for; empty = same as LLM_MODEL

# Last-resort AI (paid, Claude): console.anthropic.com/settings/keys - only used when both of the above fail
ANTHROPIC_API_KEY=

# Supabase (later): supabase.com -> Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Razorpay (Pro prices for each kind of student and the launch offer: PRO_PRICES_INR, PRO_OFFER_PRICES_INR and
# PRO_OFFER_PLACES in backend/app/core/config.py; mentors price their own calls): dashboard.razorpay.com -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks: URL <your server>/api/billing/webhook, events payment.captured + order.paid, then paste its secret
RAZORPAY_WEBHOOK_SECRET=

# Hosting behind a proxy (Cloud Run: 1, behind a Google load balancer: 2). Leave 0 on your own PC.
TRUSTED_PROXY_HOPS=0

# Live server: production switches off every dev shortcut
# ENV=production

# What free accounts, all together, may spend on AI a day: this many rupees plus a share of the last 30 days' Pro income.
# Past it they get offline answers until 05:30 IST; Pro carries on. (Each student is also capped over 30 days:
# AI_CEILING_FREE_INR=40; on Pro what the student's pass brings in, up to AI_CEILING_PRO_INR=300.)
FREE_AI_DAY_FLOOR_INR=50
FREE_AI_REVENUE_SHARE=0.2

# Don't change
SECRET_KEY=change-me

# Admin panel (/admin): its own ID and password. Run set_admin.bat to set them; only a bcrypt hash is stored.
ADMIN_USERNAME=admin@edify
ADMIN_PASSWORD_HASH=

# Edify Coach: every student's own study coach, an agent on Maritime (agents/edify-coach).
# On Maritime: an API key (maritime keys create --name edify --json) and the coach's GitHub repo.
MARITIME_API_KEY=
MARITIME_COACH_REPO=
# MARITIME_COACH_BRANCH=main
# MARITIME_USE_LLM=false   (true: coaches use Maritime's metered LLM instead of the key above)
# MARITIME_COACH_TIER=smart   (smart $1/month a student, sleeps when idle; extended $5; always_on $10)
# To try the coach on this PC instead: run agents\edify-coach\server.py, then
# MARITIME_COACH_URL=http://127.0.0.1:8787
